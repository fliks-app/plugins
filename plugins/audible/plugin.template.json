{
  "id": "fliks.audible",
  "pluginApi": 3,
  "name": "Audible",
  "fliks": ">=6.0.0 <7.0.0",
  "author": "Fliks",
  "description": "Audiobook metadata from the unofficial Audible catalog: search and editions by ASIN.",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.svg",
  "kind": "process",
  "runtime": "wasm",
  "memoryMb": 64,
  "database": { "schema": false, "coreRefs": [] },
  "scopes": [],
  "ingestRoots": [],
  "routes": [],
  "provider": {
    "namespaces": [{ "name": "audible" }],
    "kinds": { "book": ["search", "edition"] },
    "editionNamespaces": ["asin"],
    "limits": { "ratePerSec": 1, "burst": 1 },
    "snapshotTtlSecs": { "edition": 2592000 },
    "imageHosts": ["m.media-amazon.com"]
  }
}
