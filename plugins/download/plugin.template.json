{
  "id": "fliks.download",
  "pluginApi": 3,
  "name": "Download",
  "fliks": ">=6.0.0 <7.0.0",
  "author": "Fliks",
  "description": "Indexer search, download-client management and the acquisition grab pipeline for Fliks.",
  "license": "AGPL-3.0-or-later",
  "logo": "logo.svg",
  "kind": "process",
  "runtime": "wasm",
  "memoryMb": 128,
  "database": {
    "schema": true,
    "coreRefs": [
      "item_groups",
      "items",
      "media",
      "users"
    ],
    "secrets": [
      {
        "table": "indexers",
        "column": "settings",
        "jsonPath": "apiKey"
      },
      {
        "table": "indexer_sources",
        "column": "settings",
        "jsonPath": "apiKey"
      },
      {
        "table": "download_clients",
        "column": "settings",
        "jsonPath": "password"
      }
    ]
  },
  "routes": [
    {
      "method": "GET",
      "path": "/:id/releases",
      "policy": "read:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "POST",
      "path": "/:id/grab",
      "policy": "grab:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "GET",
      "path": "/:id/groups/:groupId/releases",
      "policy": "read:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "POST",
      "path": "/:id/groups/:groupId/grab",
      "policy": "grab:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "GET",
      "path": "/:id/items/:itemId/releases",
      "policy": "read:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "POST",
      "path": "/:id/items/:itemId/grab",
      "policy": "grab:plugin:fliks.download:releases",
      "objectGuard": "mediaAccessible:id"
    },
    {
      "method": "GET",
      "path": "/indexers",
      "policy": "read:plugin:fliks.download:indexers"
    },
    {
      "method": "POST",
      "path": "/indexers",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "POST",
      "path": "/indexers/test-connection",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "DELETE",
      "path": "/indexers/cooldowns",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "GET",
      "path": "/indexers/implementations",
      "policy": "read:plugin:fliks.download:indexers"
    },
    {
      "method": "PUT",
      "path": "/indexers/:id",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "DELETE",
      "path": "/indexers/:id",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "DELETE",
      "path": "/indexers/:id/cooldown",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "GET",
      "path": "/indexers/:id/stats",
      "policy": "read:plugin:fliks.download:indexers"
    },
    {
      "method": "GET",
      "path": "/indexer-sources",
      "policy": "read:plugin:fliks.download:indexers"
    },
    {
      "method": "POST",
      "path": "/indexer-sources",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "POST",
      "path": "/indexer-sources/test-connection",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "GET",
      "path": "/indexer-sources/implementations",
      "policy": "read:plugin:fliks.download:indexers"
    },
    {
      "method": "PUT",
      "path": "/indexer-sources/:id",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "DELETE",
      "path": "/indexer-sources/:id",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "POST",
      "path": "/indexer-sources/:id/import",
      "policy": "manage:plugin:fliks.download:indexers"
    },
    {
      "method": "GET",
      "path": "/download-clients",
      "policy": "read:plugin:fliks.download:download-clients"
    },
    {
      "method": "POST",
      "path": "/download-clients",
      "policy": "manage:plugin:fliks.download:download-clients"
    },
    {
      "method": "POST",
      "path": "/download-clients/test-connection",
      "policy": "manage:plugin:fliks.download:download-clients"
    },
    {
      "method": "GET",
      "path": "/download-clients/implementations",
      "policy": "read:plugin:fliks.download:download-clients"
    },
    {
      "method": "PUT",
      "path": "/download-clients/:id",
      "policy": "manage:plugin:fliks.download:download-clients"
    },
    {
      "method": "DELETE",
      "path": "/download-clients/:id",
      "policy": "manage:plugin:fliks.download:download-clients"
    },
    {
      "method": "GET",
      "path": "/blocklist",
      "policy": "read:plugin:fliks.download:blocklist"
    },
    {
      "method": "DELETE",
      "path": "/blocklist/all",
      "policy": "manage:plugin:fliks.download:blocklist"
    },
    {
      "method": "DELETE",
      "path": "/blocklist/:id",
      "policy": "manage:plugin:fliks.download:blocklist"
    },
    {
      "method": "POST",
      "path": "/queue/pause",
      "policy": "manage:plugin:fliks.download:queue-control"
    },
    {
      "method": "POST",
      "path": "/queue/resume",
      "policy": "manage:plugin:fliks.download:queue-control"
    },
    {
      "method": "POST",
      "path": "/queue/remove",
      "policy": "manage:plugin:fliks.download:queue-control"
    },
    {
      "method": "POST",
      "path": "/queue/retry-import",
      "policy": "manage:plugin:fliks.download:queue-control"
    }
  ],
  "scopes": [
    "media:read",
    "acquisition:candidates",
    "releases:score",
    "ingest:write",
    "events:emit",
    "config:rw"
  ],
  "ingestRoots": [
    "/downloads"
  ],
  "network": {
    "internal": true
  },
  "jobs": [
    {
      "name": "RssSync",
      "cron": "*/15 * * * *",
      "triggerable": true,
      "labelKey": "download.jobs.rss_sync"
    },
    {
      "name": "ImportCompleted",
      "cron": "*/1 * * * *",
      "triggerable": true,
      "labelKey": "download.jobs.import_completed"
    },
    {
      "name": "CleanStalled",
      "cron": "0 */5 * * * *",
      "triggerable": true,
      "labelKey": "download.jobs.clean_stalled"
    },
    {
      "name": "CleanSeeded",
      "cron": "0 */5 * * * *",
      "triggerable": true,
      "labelKey": "download.jobs.clean_seeded"
    }
  ],
  "permissions": [
    "releases",
    "indexers",
    "download-clients",
    "queue-control",
    "blocklist"
  ],
  "acquisition": {
    "queueActions": {
      "pause": "/queue/pause",
      "resume": "/queue/resume",
      "remove": "/queue/remove",
      "retryImport": "/queue/retry-import"
    }
  },
  "ui": {
    "contributions": [
      {
        "id": "fliks-download.settings.general",
        "slot": "settings.page",
        "weight": 100,
        "labelKey": "download.config.general.title",
        "icon": "download",
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.download/general"
        }
      },
      {
        "id": "fliks-download.settings.indexers",
        "slot": "settings.page",
        "weight": 110,
        "labelKey": "download.config.indexers.title",
        "icon": "search",
        "when": [
          "hasPermission:read:plugin:fliks.download:indexers"
        ],
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.download/indexers"
        }
      },
      {
        "id": "fliks-download.settings.indexer-sources",
        "slot": "settings.page",
        "weight": 115,
        "labelKey": "download.config.indexer_sources.title",
        "icon": "server",
        "when": [
          "hasPermission:read:plugin:fliks.download:indexers"
        ],
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.download/indexer-sources"
        }
      },
      {
        "id": "fliks-download.settings.download-clients",
        "slot": "settings.page",
        "weight": 120,
        "labelKey": "download.config.download_clients.title",
        "icon": "server",
        "when": [
          "hasPermission:read:plugin:fliks.download:download-clients"
        ],
        "action": {
          "kind": "route",
          "path": "/admin/settings/plugins/fliks.download/download-clients"
        }
      }
    ],
    "configPages": [
      {
        "id": "general",
        "labelKey": "download.config.general.title",
        "subtitleKey": "download.config.general.subtitle",
        "icon": "download",
        "fields": [
          {
            "key": "auto_acquisition_paused",
            "type": "toggle",
            "labelKey": "download.config.general.auto_acquisition_paused",
            "hint": "download.config.general.auto_acquisition_paused_hint",
            "default": false
          },
          {
            "key": "search_budget_seconds",
            "type": "number",
            "labelKey": "download.config.general.search_budget_seconds",
            "hint": "download.config.general.search_budget_seconds_hint",
            "default": 30,
            "min": 5,
            "max": 120
          },
          {
            "key": "stall_samples",
            "type": "number",
            "labelKey": "download.config.stall.samples",
            "hint": "download.config.stall.samples_hint",
            "min": 2,
            "max": 100
          },
          {
            "key": "stall_interval_minutes",
            "type": "number",
            "labelKey": "download.config.stall.interval_minutes",
            "hint": "download.config.stall.interval_minutes_hint",
            "default": 60,
            "min": 5,
            "max": 1440
          },
          {
            "key": "stall_min_speed_kib",
            "type": "number",
            "labelKey": "download.config.stall.min_speed_kib",
            "hint": "download.config.stall.min_speed_kib_hint",
            "default": 8,
            "min": 1,
            "max": 102400
          },
          {
            "key": "stall_auto_restart",
            "type": "toggle",
            "labelKey": "download.config.stall.auto_restart",
            "hint": "download.config.stall.auto_restart_hint",
            "default": true
          },
          {
            "key": "stall_include_manual_grabs",
            "type": "toggle",
            "labelKey": "download.config.stall.include_manual_grabs",
            "hint": "download.config.stall.include_manual_grabs_hint",
            "default": false
          }
        ]
      },
      {
        "id": "indexers",
        "kind": "providers",
        "labelKey": "download.config.indexers.title",
        "subtitleKey": "download.config.indexers.subtitle",
        "icon": "search",
        "list": "/indexers",
        "implementations": "/indexers/implementations",
        "testConnection": {
          "route": "/indexers/test-connection"
        },
        "showPriority": true,
        "defaultPriority": 25,
        "bulkSelect": true,
        "labels": {
          "newKey": "download.config.indexers.labels.new",
          "emptyKey": "download.config.indexers.labels.empty",
          "testKey": "download.config.indexers.labels.test",
          "deleteConfirmKey": "download.config.indexers.labels.delete_confirm",
          "createTitleKey": "download.config.indexers.labels.create_title",
          "editTitleKey": "download.config.indexers.labels.edit_title"
        },
        "actions": [
          {
            "id": "stats",
            "labelKey": "download.config.indexers.actions.stats",
            "method": "GET",
            "route": "/indexers/:id/stats",
            "scope": "row",
            "result": {
              "kind": "table",
              "emptyKey": "download.config.indexers.stats.empty",
              "columns": [
                {
                  "key": "date",
                  "labelKey": "download.config.indexers.stats.date"
                },
                {
                  "key": "queries",
                  "labelKey": "download.config.indexers.stats.queries"
                },
                {
                  "key": "avgResponseMs",
                  "labelKey": "download.config.indexers.stats.avg_response"
                },
                {
                  "key": "totalResults",
                  "labelKey": "download.config.indexers.stats.results"
                },
                {
                  "key": "errors",
                  "labelKey": "download.config.indexers.stats.errors"
                }
              ]
            }
          },
          {
            "id": "clear-cooldown",
            "labelKey": "download.config.indexers.actions.clear_cooldown",
            "method": "DELETE",
            "route": "/indexers/:id/cooldown",
            "scope": "row",
            "slot": "cooldown-reset",
            "confirmKey": "download.config.indexers.actions.clear_cooldown_confirm"
          },
          {
            "id": "clear-all-cooldowns",
            "labelKey": "download.config.indexers.actions.clear_all_cooldowns",
            "method": "DELETE",
            "route": "/indexers/cooldowns",
            "scope": "list"
          }
        ]
      },
      {
        "id": "indexer-sources",
        "kind": "providers",
        "labelKey": "download.config.indexer_sources.title",
        "subtitleKey": "download.config.indexer_sources.subtitle",
        "icon": "server",
        "list": "/indexer-sources",
        "implementations": "/indexer-sources/implementations",
        "testConnection": {
          "route": "/indexer-sources/test-connection"
        },
        "showPriority": false,
        "labels": {
          "newKey": "download.config.indexer_sources.labels.new",
          "emptyKey": "download.config.indexer_sources.labels.empty",
          "testKey": "download.config.indexer_sources.labels.test",
          "deleteConfirmKey": "download.config.indexer_sources.labels.delete_confirm",
          "createTitleKey": "download.config.indexer_sources.labels.create_title",
          "editTitleKey": "download.config.indexer_sources.labels.edit_title"
        },
        "actions": [
          {
            "id": "import",
            "labelKey": "download.config.indexer_sources.actions.import",
            "method": "POST",
            "route": "/indexer-sources/:id/import",
            "scope": "row",
            "successKey": "download.config.indexer_sources.actions.import_done",
            "afterSave": true
          }
        ]
      },
      {
        "id": "download-clients",
        "kind": "providers",
        "labelKey": "download.config.download_clients.title",
        "subtitleKey": "download.config.download_clients.subtitle",
        "icon": "server",
        "list": "/download-clients",
        "implementations": "/download-clients/implementations",
        "testConnection": {
          "route": "/download-clients/test-connection"
        },
        "showPriority": true,
        "defaultPriority": 1,
        "labels": {
          "newKey": "download.config.download_clients.labels.new",
          "emptyKey": "download.config.download_clients.labels.empty",
          "testKey": "download.config.download_clients.labels.test",
          "deleteConfirmKey": "download.config.download_clients.labels.delete_confirm",
          "createTitleKey": "download.config.download_clients.labels.create_title",
          "editTitleKey": "download.config.download_clients.labels.edit_title"
        }
      }
    ],
    "releasePicker": {
      "movie": {
        "work": {
          "search": "/:id/releases",
          "grab": "/:id/grab"
        }
      },
      "series": {
        "group": {
          "search": "/:id/groups/:groupId/releases",
          "grab": "/:id/groups/:groupId/grab"
        },
        "item": {
          "search": "/:id/items/:itemId/releases",
          "grab": "/:id/items/:itemId/grab"
        }
      },
      "book": {
        "work": {
          "search": "/:id/releases",
          "grab": "/:id/grab"
        }
      },
      "comic": {
        "work": {
          "search": "/:id/releases",
          "grab": "/:id/grab"
        },
        "item": {
          "search": "/:id/items/:itemId/releases",
          "grab": "/:id/items/:itemId/grab"
        }
      },
      "album": {
        "work": {
          "search": "/:id/releases",
          "grab": "/:id/grab"
        },
        "item": {
          "search": "/:id/items/:itemId/releases",
          "grab": "/:id/items/:itemId/grab"
        }
      }
    }
  },
