{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "packages": {
    "download": {
      "release-type": "rust",
      "component": "download",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fk-plugin-download')].version"
        }
      ]
    },
    "notify": {
      "release-type": "rust",
      "component": "notify",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fk-plugin-notify')].version"
        }
      ]
    },
    "providers/openlibrary": {
      "release-type": "rust",
      "component": "openlibrary",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fk-plugin-openlibrary')].version"
        }
      ]
    }
  }
}
