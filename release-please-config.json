{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "packages": {
    "plugins/download": {
      "release-type": "rust",
      "component": "download",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fk-plugin-download')].version"
        }
      ]
    },
    "plugins/notify": {
      "release-type": "rust",
      "component": "notify",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
